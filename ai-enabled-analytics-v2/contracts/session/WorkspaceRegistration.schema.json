{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asml.com/contracts/session/WorkspaceRegistration.schema.json",
  "title": "WorkspaceRegistration",
  "description": "One row from the workspace_registrations table (db/schema.sql), tracking dataset registration status for a workspace.",
  "type": "object",
  "required": ["workspace_id", "dataset", "table_name", "status"],
  "properties": {
    "workspace_id": { "type": "string" },
    "session_id": { "type": ["string", "null"] },
    "dataset": { "type": "string" },
    "table_name": { "type": "string" },
    "status": { "type": "string", "enum": ["IN_PROGRESS", "READY"] },
    "progress_pct": { "type": ["integer", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
