# ai-enabled-analytics-v2 environment template. Copy to `.env` and fill in as needed.
# All settings map to foundation/config.py (ASML_AI_*) and
# application_ui/opo_monitoring_service/config.py (ASML_AI_V2_*).

ASML_AI_BASE_URL=https://platform.ai.asml.com
ASML_AI_DEPLOYMENT=mistral-large-3-ssa
ASML_AI_API_VERSION=2024-10-21
ASML_AI_TEMPERATURE=0.2

ASML_AI_KEY_VAULT_URL=https://ssa-prd-proj-15528-01-kv.vault.azure.net/
ASML_AI_SECRET_NAME=ssa-ai-key

# Single PostgreSQL runtime-state store (checkpoints + sessions/audit/memory)
ASML_AI_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_enabled_analytics_v2

# MCP transport: "stdio" (default, in-process for local dev) or "streamable-http"
ASML_AI_MCP_TRANSPORT=stdio

# v2 BFF host/port (kept separate from the original demonstrator's 8000/8010)
ASML_AI_V2_HOST=127.0.0.1
ASML_AI_V2_PORT=8100
