FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/requirements.txt

COPY AnalyticsFoundation /app/AnalyticsFoundation
COPY ApplicationUI /app/ApplicationUI
COPY ai-enabled-analytics-v2/agent_runtime /app/ai-enabled-analytics-v2/agent_runtime
COPY ai-enabled-analytics-v2/ai_Agents /app/ai-enabled-analytics-v2/ai_Agents
COPY ai-enabled-analytics-v2/contracts /app/ai-enabled-analytics-v2/contracts

EXPOSE 8000

ARG APP_MODULE=ApplicationUI.analytics_agents.opo_monitoring_service.api:app
ENV APP_MODULE=${APP_MODULE} \
    PYTHONPATH=/app:/app/ai-enabled-analytics-v2

CMD ["sh", "-c", "python -m uvicorn ${APP_MODULE} --host 0.0.0.0 --port 8000"]
