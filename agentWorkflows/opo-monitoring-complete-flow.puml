@startuml OPO Monitoring Complete Flow

' Complete OPO monitoring interaction and investigation workflow.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #0F172A
skinparam ArrowColor #475569
skinparam partitionBackgroundColor #F8FAFC
skinparam partitionBorderColor #94A3B8
skinparam partitionFontColor #0F172A
skinparam partitionFontSize 14
skinparam activity {
  BackgroundColor #E0F2FE
  BorderColor #1D4ED8
  FontColor #0F172A
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #B45309
  StartColor #16A34A
  EndColor #DC2626
  BarColor #2563EB
}
skinparam note {
  BackgroundColor #F1F5F9
  BorderColor #64748B
  FontColor #0F172A
}

start

partition "Application UI - OPO Monitoring UI" {
  :Load OPO Monitoring UI;
  :Request raw trend data;
  :Render daily trend chart;
  :Initialize empty wafer map;
  :Initialize empty conversation history;
  :User enters investigation request
  in the right-side agent panel;
}

partition "OPO Monitoring Service - Application-owned workflow" {
  :Create or resume session;
  :Record user_request event;
}

partition "Model" {
  :Model interprets user intent,
  filters, time range, and explicit threshold;
}

note right
  Example model input:
  "Show me outliers above 3.1 for NXE3600
  in product P200 over the last 7 days"

  Example model output:
  {
    mode: absolute,
    direction: above,
    limit_value: 3.1,
    threshold_unit: absolute,
    machine_id: NXE3600,
    product_id: P200,
    lookback_days: 7
  }
end note

partition "OPO Monitoring Service - Application-owned workflow" {
  :Validate model scope;
  :Apply explicit phrase parsing
  and bounds validation;
}

if (Explicit absolute KPI threshold supplied?) then (yes)
  :Use the user-provided absolute KPI cutoff;
else (no)
  partition "Analytics Foundation - Query Engine capability" {
    :Read raw OPO KPI trend rows;
  }

  partition "OPO Monitoring Service - Application-owned analysis" {
    :Calculate empirical KPI statistics;
    :Calculate P95 and P99 as absolute KPI values;
    :Build threshold context;
  }

  partition "Model" {
    :Recommend one absolute cutoff
    using P95/P99 context;
    :Return suggested_limit_value
    and rationale;
  }

  note right
    Example model input:
    {
      metric: OPO KPI,
      unit: absolute,
      p95: 3.196,
      p99: 3.293
    }

    Example model output:
    {
      suggested_limit_value: 3.2,
      rationale: "P95 gives broader screening"
    }
  end note

  partition "Application UI - OPO Monitoring UI" {
    :Show P95 and P99 as reference values;
    :Show the model recommendation;
    :Ask the user to approve or edit
    the selected absolute cutoff;
  }

  if (User approves a cutoff?) then (yes)
    :Store approved limit_value;
  else (no)
    :Record rejection;
    stop
  endif
endif

partition "OPO Monitoring Service - Application-owned analysis" {
  :Read or reuse OPO KPI trend rows;
  :Apply the selected absolute KPI threshold;
  :Detect and rank outlier series;
  :Record evidence_item and timing;
}

if (Outliers found?) then (yes)
  partition "Application UI - OPO Monitoring UI" {
    :Show outliers in the right-side
    interaction history;
    :Ask user to select or approve
    an outlier;
  }

  if (User approves an outlier?) then (yes)
    :Store selected outlier;
    :Record human_decision event;
  else (no)
    :Record rejection;
    stop
  endif
else (no)
  partition "Application UI - OPO Monitoring UI" {
    :Show no-outliers result
    and applied threshold;
  }
  stop
endif

partition "Analytics Foundation - Workspace capability" {
  :Create workspace;
  :Apply machine and product filters;
}

partition "Application UI - OPO Monitoring UI" {
  :Show workspace and filter evidence;
  :Ask user to approve dataset registration;
}

if (User approves registration?) then (yes)
  :Record human_decision event;
else (no)
  :Record rejection;
  stop
endif

partition "Analytics Foundation - Workspace capability" {
  :Register overlay wafer dataset;
  :Poll registration status;
}

if (Registration READY?) then (yes)
  :Record registration evidence;
else (no)
  :Record timeout or failure;
  stop
endif

partition "Analytics Foundation - Query Engine capability" {
  :Read raw wafer-level rows;
}

partition "OPO Monitoring Service - Application-owned analysis" {
  :Apply workspace filters;
  :Normalize wafer identifiers and measurements;
  :Calculate overlay magnitude;
  :Identify anomalous wafers;
  :Record wafer evidence;
}

partition "Application UI - OPO Monitoring UI" {
  :Render wafer map and wafer evidence
  in the right-side agent panel;
}

partition "Model" {
  :Summarize selected outlier and
  supplied evidence using structured output;
}

note right
  Model input - structured evidence:
  {
    selected_outlier: {
      machine: NXE3600,
      product: P200,
      extreme_kpi_value: 3.21,
      outlier_dates: [2026-09-12, 2026-09-13]
    },
    applied_filters: {machine: NXE3600, product: P200},
    workspace: WS-AB12CD34,
    registration: READY,
    anomalous_wafers: [W004, W006],
    wafer_rows: [...]
  }

  Model output - FindingsSummary:
  {
    finding: "Elevated OPO KPI on NXE3600",
    evidence_references: [selected_outlier, anomalous_wafers],
    confidence: medium,
    limitations: ["No confirmed root cause"],
    recommended_next_actions: ["Compare same layer on another machine"],
    alternative_explanations: ["Lot variation", "Measurement variation"]
  }
end note

partition "OPO Monitoring Service - Application-owned workflow" {
  :Validate structured findings;
  :Record final_finding and timing;
}

partition "Application UI - OPO Monitoring UI" {
  :Show Investigation result beside evidence;
  :Show finding, confidence, evidence references,
  limitations, alternative explanations,
  and recommended next actions;
  :Keep complete interaction history scrollable
  in the right panel;
}

stop

note right
  Ownership boundary:
  - Application owns workflow, KPI semantics,
    threshold application, wafer interpretation,
    UI, and visualization.
  - Analytics Foundation provides model connectivity,
    governed capabilities, permissions, session
    events, timing, and platform API access.
  - The model interprets, recommends, and explains;
    it does not perform deterministic KPI calculations.
end note

@enduml
